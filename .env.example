# Configuración de Entorno para DeliveryTracker (E-commerce de Ropa)
# Copia este archivo como .env y edita los valores. .env NUNCA debe subirse a Git.
# No colocar llaves o tokens privados con prefijo EXPO_PUBLIC_ (se incrustan en el bundle JS).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.vogueatelier.local/v1
EXPO_PUBLIC_STORE_NAME=Atelier Noir - Moda Urbana
